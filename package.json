{
  "name": "dsh-nvidia-models-panel",
  "version": "1.3.21",
  "type": "module",
  "description": "Nvidia 模型面板 — 检测 NVIDIA NIM 可用模型、逐个真实试调用验证、面板内保存 API Key，一键配置进 DeepSeek Harness 设置",
  "description.en": "Detects available NVIDIA NIM models, verifies each with a real streaming call, saves the API key in-panel, and one-click configures DeepSeek Harness settings.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "nvidia",
    "nim",
    "llm-provider"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windxxf/dsh-nvidia-models-panel.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/index.js",
    "src/group.js",
    "src/usage.js",
    "src/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
